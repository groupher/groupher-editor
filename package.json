{
  "name": "@groupher/rich-editor",
  "private": false,
  "version": "0.0.36",
  "main": "dist/rich-editor.js",
  "module": "dist/rich-editor.js",
  "types": "dist/index.d.ts",
  "style": "dist/rich-editor.css",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rich-editor.js",
      "default": "./dist/rich-editor.js"
    },
    "./diff-viewer": {
      "types": "./dist/diff-viewer.d.ts",
      "import": "./dist/diff-viewer.js",
      "default": "./dist/diff-viewer.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "default": "./dist/static.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js",
      "default": "./dist/diff.js"
    },
    "./style.css": "./dist/rich-editor.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.node.config.ts && vite build --config vite.diff.config.ts && npm run build:types && tsc --project tsconfig.node-types.json && tsc --project tsconfig.diff-types.json",
    "clean": "rm -rf dist",
    "build:diff": "vite build --config vite.diff.config.ts && tsc --project tsconfig.diff-types.json",
    "typecheck": "tsc",
    "build:types": "tsc --project tsconfig.types.json && tsc --project tsconfig.diff-viewer-types.json && tsc --project tsconfig.static-types.json",
    "build:vite": "vite build",
    "build:node": "vite build --config vite.node.config.ts && tsc --project tsconfig.node-types.json",
    "release": "npm publish --access public",
    "preview": "vite preview",
    "test": "vitest run",
    "test:package": "npm run build && node tests/package-smoke.mjs && npm pack --dry-run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.12",
    "@emoji-mart/data": "^1.2.1",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/callout": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/diff": "^53.0.0",
    "@platejs/emoji": "^53.1.7",
    "@platejs/floating": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.3.1",
    "@platejs/list": "^53.1.3",
    "@platejs/markdown": "^53.2.2",
    "@platejs/mention": "^53.0.0",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@platejs/toggle": "^53.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.12",
    "@udecode/cn": "^52.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.542.0",
    "platejs": "^53.2.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "scheduler": "^0.27.0",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
